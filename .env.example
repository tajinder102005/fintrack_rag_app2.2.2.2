# Environment Variables
# Atlas: special characters in the password must be URL-encoded (e.g. @ → %40).
# Optional but recommended on Atlas: ?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@cluster.mongodb.net/fintrackDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fintrackDB
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
PORT=5000
NODE_ENV=development
SESSION_SECRET=your_session_secret_here

# App URLs (React dev server vs API server)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Google OAuth — see GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth — create app at https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL (must match exactly):
#   http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Frontend (optional; defaults to http://localhost:5000/api)
# REACT_APP_API_URL=http://localhost:5000/api

# Google Gemini — AI financial coach (server only; see GEMINI_SETUP.md)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
