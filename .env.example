# Environment Variables
# Atlas: special characters in the password must be URL-encoded (e.g. @ → %40).
# Optional but recommended on Atlas: ?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@cluster.mongodb.net/fintrackDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fintrackDB
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
PORT=5000
NODE_ENV=development

# OAuth Credentials (Get these from Google Cloud Console and GitHub Developer Settings)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Shared Secrets
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# URLs
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
